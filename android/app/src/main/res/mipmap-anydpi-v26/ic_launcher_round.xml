<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon (Android 8+), which is what every modern launcher actually draws — the legacy
  ic_launcher bitmap is only a fallback. Its foreground used to be the Expo starter template's blue
  chevron and its background the template's pale blue, which is why the launcher showed neither the
  app's mark nor iOS's, long after the legacy bitmap had been updated.

  Background is a flat colour rather than a bitmap: it is one solid red, so a per-density image was
  only ever a heavier way to say #E31937.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/iconBackground"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
