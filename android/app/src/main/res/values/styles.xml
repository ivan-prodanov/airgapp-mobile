<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <!--
      PIN THE WINDOW BACKGROUND. The parent is DayNight, so on a phone in LIGHT mode (`adb shell
      cmd uimode night` → "Night mode: no") this resolves to WHITE — and that is what the user
      sees flash.

      The Godot renderer is a GLSurfaceView, i.e. a punch-through surface: it reaches the screen
      through a hole cut in the window, so whatever the window paints is what shows the moment that
      surface is torn down. Navigating away from Home does exactly that, which made the HOME screen
      flash white right before the push animation — while every other screen, having no surface to
      tear down, slid cleanly.

      This app has no light mode, so the day/night split was never meaningful here; #161718 is the
      Godot scene's own background, so the hole matches what was in it.
    -->
    <item name="android:windowBackground">@color/windowBackground</item>
    <item name="android:colorBackground">@color/windowBackground</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/splashscreen_logo</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
  </style>
  <!--
    The share sheet's window. Transparent and non-floating: ShareSheet.tsx draws its own scrim and
    card, so the window must contribute nothing of its own — a themed windowBackground here would
    paint an opaque panel behind the sheet and hide the app the user shared from.
  -->
  <style name="Theme.App.ShareSheet" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowContentOverlay">@null</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">false</item>
    <!-- The scrim is ours; the system dim would double it. -->
    <item name="android:backgroundDimEnabled">false</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
  </style>
</resources>