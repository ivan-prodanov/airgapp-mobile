+// iOS 16+ routes taps on Apple's built-in map features (POIs / cities / landmarks made tappable via
+// selectableMapFeatures) through THIS annotation-based delegate, NOT didSelectAnnotationView:. Forward the
+// feature to JS via onPoiClick. We leave the feature selected (Apple's native enlarge), mirroring the Maps
+// app; tapping elsewhere deselects it and our JS dismisses the card. Extra place data that doesn't fit the
+// pre-generated onPoiClick struct (category, icon colour, address, phone, website) is packed as a JSON string
+// in `placeId` — the synchronous fields fire immediately; address/phone/website enrich via MKMapItemRequest.
+- (void)mapView:(AIRMap *)mapView didSelectAnnotation:(id<MKAnnotation>)annotation
+{
+    if (@available(iOS 16.0, *)) {
+        if (![annotation isKindOfClass:[MKMapFeatureAnnotation class]]) return;
+        MKMapFeatureAnnotation *feature = (MKMapFeatureAnnotation *)annotation;
+
+        // This tap selected a built-in feature → it's a feature tap, not a background tap. Cancel the pending
+        // map onPress queued by handleMapTap so the RN preview card doesn't flicker to the Location sheet.
+        if (mapView.pendingMapPressBlock) {
+            dispatch_block_cancel(mapView.pendingMapPressBlock);
+            mapView.pendingMapPressBlock = nil;
+        }
+
+        if (!mapView.onPoiClick) return;
+
+        CLLocationCoordinate2D coord = feature.coordinate;
+        NSString *name = feature.title ?: @"";
+        CGPoint pt = [mapView convertCoordinate:coord toPointToView:mapView];
+
+        // Emits onPoiClick with the extras packed into placeId as JSON (name/coordinate stay first-class).
+        __weak AIRMap *weakMap = mapView;
+        void (^emit)(NSDictionary *) = ^(NSDictionary *extra) {
+            AIRMap *m = weakMap;
+            if (!m || !m.onPoiClick) return;
+            NSData *json = [NSJSONSerialization dataWithJSONObject:extra options:0 error:nil];
+            NSString *jsonStr = json ? [[NSString alloc] initWithData:json encoding:NSUTF8StringEncoding] : @"{}";
+            m.onPoiClick(@{
+                @"placeId": jsonStr ?: @"{}",
+                @"name": name,
+                @"coordinate": @{ @"latitude": @(coord.latitude), @"longitude": @(coord.longitude) },
+                @"position": @{ @"x": @(pt.x), @"y": @(pt.y) },
+            });
+        };
+
+        // Synchronous extras straight off the feature (no network): category + Apple's own icon colour.
+        NSMutableDictionary *extra = [NSMutableDictionary dictionary];
+        if (feature.pointOfInterestCategory) extra[@"category"] = feature.pointOfInterestCategory; // raw MKPOICategory*, cleaned in JS
+        UIColor *bg = feature.iconStyle.backgroundColor;
+        if (bg) {
+            CGFloat r = 0, g = 0, b = 0, a = 0;
+            if ([bg getRed:&r green:&g blue:&b alpha:&a]) {
+                extra[@"color"] = [NSString stringWithFormat:@"#%02X%02X%02X", (int)(r * 255), (int)(g * 255), (int)(b * 255)];
+            }
+        }
+        emit(extra); // fire the card immediately from the synchronous data
+
+        // Enrich asynchronously with the full place-card data (address / phone / website), then fire again.
+        MKMapItemRequest *req = [[MKMapItemRequest alloc] initWithMapFeatureAnnotation:feature];
+        [req getMapItemWithCompletionHandler:^(MKMapItem * _Nullable item, NSError * _Nullable e) {
+            if (!item) return;
+            NSMutableDictionary *rich = [extra mutableCopy];
+            MKPlacemark *pm = item.placemark;
+            NSMutableArray<NSString *> *parts = [NSMutableArray array];
+            if (pm.thoroughfare.length) {
+                [parts addObject:(pm.subThoroughfare.length ? [NSString stringWithFormat:@"%@ %@", pm.subThoroughfare, pm.thoroughfare] : pm.thoroughfare)];
+            }
+            if (pm.locality.length) [parts addObject:pm.locality];
+            if (pm.administrativeArea.length) [parts addObject:pm.administrativeArea];
+            NSString *addr = [parts componentsJoinedByString:@", "];
+            if (addr.length) rich[@"address"] = addr;
+            if (item.phoneNumber.length) rich[@"phone"] = item.phoneNumber;
+            if (item.url.absoluteString.length) rich[@"url"] = item.url.absoluteString;
+            dispatch_async(dispatch_get_main_queue(), ^{ emit(rich); });
+        }];
+    }
+}
