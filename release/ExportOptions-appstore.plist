<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Store / TestFlight distribution export (Xcode 15.3+ renamed "app-store" -> "app-store-connect"). -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>859B8N529C</string>
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
  <!-- Export the .ipa locally; we upload separately via the App Store Connect API key. -->
  <key>destination</key>
  <string>export</string>
</dict>
</plist>
